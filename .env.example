# Copy this file to .env and fill in the values from your Supabase project
# (Project Settings → API). Lovable Cloud injects these automatically when
# the app runs inside Lovable; running the repo locally with `npm run dev`
# requires setting them yourself, or pages that query Supabase (e.g.
# /professeurs) fail with a generic loading error.

# Used by server-side code (TanStack Start server functions, SSR).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key

# Used by client-side code (Vite injects VITE_-prefixed vars into the browser bundle).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key

# Server-only, never exposed to the browser: bypasses RLS. Required for
# operations like signing private storage URLs (teacher photos/documents).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
